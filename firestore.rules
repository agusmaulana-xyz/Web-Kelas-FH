rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validJournal(id) {
      let d = request.resource.data;
      return d.keys().hasAll(['title','author','abstract','category','kind','content','ownerId','createdAt','filePath','fileName','fileSize'])
        && d.keys().hasOnly(['title','author','abstract','category','kind','content','ownerId','createdAt','filePath','fileName','fileSize'])
        && d.ownerId == request.auth.uid
        && d.createdAt == request.time
        && d.title is string && d.title.size() >= 5 && d.title.size() <= 180
        && d.author is string && d.author.size() >= 2 && d.author.size() <= 100
        && d.abstract is string && d.abstract.size() >= 20 && d.abstract.size() <= 2000
        && d.category in ['Hukum Pidana','Hukum Perdata','Hukum Tata Negara','Hukum Internasional','Hukum Administrasi','Hukum Lingkungan','Lainnya']
        && d.content is string && d.content.size() <= 100000
        && d.fileName is string && d.fileName.size() <= 180
        && d.fileSize is int
        && ((d.kind == 'text' && d.content.size() >= 20 && d.filePath == '' && d.fileName == '' && d.fileSize == 0)
          || (d.kind in ['pdf','docx'] && d.content == '' && d.fileSize > 0 && d.fileSize <= 10485760
            && d.fileName.size() > 0
            && d.filePath == 'journals/' + request.auth.uid + '/' + id + '/source.' + d.kind));
    }
    match /journals/{id} {
      // Guests use Firebase Anonymous Auth and receive a real UID.
      allow read: if signedIn();
      allow create: if signedIn() && validJournal(id);
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
