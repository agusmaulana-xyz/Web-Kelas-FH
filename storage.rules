rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /journals/{ownerId}/{journalId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == ownerId
        && request.resource.size > 0 && request.resource.size <= 10485760
        && ((fileName == 'source.pdf' && request.resource.contentType == 'application/pdf')
          || (fileName == 'source.docx' && request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'));
      // Enables cleanup if saving the corresponding Firestore document fails.
      allow delete: if request.auth != null && request.auth.uid == ownerId;
      allow update: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
